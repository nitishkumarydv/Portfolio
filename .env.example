# ── Server settings ─────────────────────────────────────────
# Port for the Node server (default 3000)
PORT=3000

# Secret key to open your inbox at /admin?key=...
# If left unset, a random key is printed in the console on every start.
ADMIN_KEY=change-this-to-a-long-secret

# ── Optional: email notifications ───────────────────────────
# Requires: npm install   (installs nodemailer)
# Gmail example: enable 2-Step Verification, create an App Password
# at https://myaccount.google.com/apppasswords and use it below.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=lalyadvanitish6@gmail.com
# SMTP_PASS=your-16-char-app-password
# CONTACT_TO=lalyadvanitish6@gmail.com
